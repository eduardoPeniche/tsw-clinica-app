---
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Clínica | Agenda</title>
	</head>
	<body>
		<main class="app-shell">
			<aside class="sidebar" aria-label="Navegación principal">
				<nav class="main-nav">
					<button class="nav-item is-active" type="button" data-view-target="calendario">
						<span aria-hidden="true">▦</span> Calendario
					</button>
					<button class="nav-item" type="button" data-view-target="pacientes">
						<span aria-hidden="true">♙</span> Pacientes
					</button>
					<button class="nav-item" type="button" data-view-target="medicos">
						<span aria-hidden="true">✚</span> Médicos
					</button>
				</nav>
			</aside>

			<div class="app-content">
				<div id="notice" class="notice" role="status" aria-live="polite" hidden>
					<span id="notice-message"></span>
					<button id="notice-close" class="notice-close" type="button" aria-label="Cerrar mensaje">
						×
					</button>
				</div>
				<section id="calendario-view" class="app-view" aria-label="Calendario">
					<div class="calendar-controls" aria-label="Controles del calendario">
						<div class="doctor-select">
							<select
								id="calendario-medico"
								class="doctor-filter"
								aria-label="Médico a visualizar"
							></select>
							<span aria-hidden="true">▾</span>
						</div>
						<div class="date-controls">
							<button
								id="fecha-anterior"
								class="icon-button calendar-arrow"
								type="button"
								aria-label="Periodo anterior"
							>
								←
							</button>
							<span class="calendar-period">
								<strong id="calendar-period"></strong>
							</span>
							<button
								id="fecha-siguiente"
								class="icon-button calendar-arrow"
								type="button"
								aria-label="Periodo siguiente"
							>
								→
							</button>
						</div>
						<button id="regresar-semana" class="calendar-return" type="button" hidden>
							Regresar a semana actual
						</button>
						<div class="view-switcher" role="group" aria-label="Vista del calendario">
							<button type="button" data-calendar-view="dia">
								Día
							</button>
							<button class="is-active" type="button" data-calendar-view="semana">
								Semana
							</button>
							<button type="button" data-calendar-view="mes">
								Mes
							</button>
						</div>
					</div>
					<div id="calendar-region" class="calendar-region" aria-live="polite"></div>
					<section id="agenda-list" class="agenda-list" aria-labelledby="agenda-dia-title">
						<div class="section-heading">
							<h2 id="agenda-dia-title">Citas del día seleccionado</h2>
						</div>
						<div class="table-wrap">
							<table>
								<thead>
									<tr>
										<th>Paciente</th>
										<th>Hora</th>
										<th>Estado</th>
										<th>
											<span class="sr-only">Acciones</span>
										</th>
									</tr>
								</thead>
								<tbody id="citas-body"></tbody>
							</table>
						</div>
					</section>
				</section>

				<section id="pacientes-view" class="app-view resource-view" aria-label="Pacientes" hidden>
					<div class="table-wrap resource-table-wrap">
						<table>
							<thead>
								<tr>
									<th>Paciente</th>
									<th>Nacimiento</th>
									<th>Contacto</th>
									<th>
										<button id="nuevo-paciente" class="button button-small" type="button">
											Agregar
										</button>
									</th>
								</tr>
							</thead>
							<tbody id="pacientes-body"></tbody>
						</table>
					</div>
				</section>

				<section id="medicos-view" class="app-view resource-view" aria-label="Médicos" hidden>
					<div class="table-wrap resource-table-wrap">
						<table>
							<thead>
								<tr>
									<th>Médico</th>
									<th>Especialidad</th>
									<th>
										<button id="nuevo-medico" class="button button-small" type="button">
											Agregar
										</button>
									</th>
								</tr>
							</thead>
							<tbody id="medicos-body"></tbody>
						</table>
					</div>
				</section>
			</div>
		</main>

		<dialog id="cita-dialog" class="appointment-dialog" aria-labelledby="cita-dialog-title">
			<form id="cita-form" method="dialog" class="appointment-form">
				<div class="dialog-heading">
					<div>
						<p class="eyebrow">Nueva cita</p>
						<h2 id="cita-dialog-title">Agendar consulta</h2>
					</div>
					<button id="cerrar-cita" class="icon-button" type="button" aria-label="Cerrar">
						×
					</button>
				</div>
				<p id="cita-resumen" class="appointment-summary"></p>
				<label>
					Paciente<select id="cita-paciente" name="paciente_id" required></select>
				</label>
				<input id="cita-medico" name="medico_id" type="hidden" />
				<input id="cita-fecha" name="fecha" type="hidden" />
				<input id="cita-hora" name="hora" type="hidden" />
				<div class="dialog-actions">
					<button id="cancelar-cita-dialog" class="button button-secondary" type="button">
						Cancelar
					</button>
					<button class="button" type="submit">
						Agendar cita
					</button>
				</div>
			</form>
		</dialog>
		<dialog id="paciente-dialog" class="appointment-dialog" aria-labelledby="paciente-dialog-title">
			<form id="paciente-form" method="dialog" class="entity-dialog-form">
				<div class="dialog-heading">
					<h2 id="paciente-dialog-title">Paciente</h2>
					<button id="cerrar-paciente" class="icon-button" type="button" aria-label="Cerrar">
						×
					</button>
				</div>
				<input name="id" type="hidden" />
				<label>
					Nombre completo
					<input name="nombre" required />
				</label>
				<label>
					Fecha de nacimiento
					<input name="fecha_nacimiento" type="date" required />
				</label>
				<label>
					Contacto
					<input name="contacto" required />
				</label>
				<div class="dialog-actions">
					<button id="cancelar-paciente-dialog" class="button button-secondary" type="button">
						Cancelar
					</button>
					<button class="button" type="submit">
						Guardar
					</button>
				</div>
			</form>
		</dialog>
		<dialog id="medico-dialog" class="appointment-dialog" aria-labelledby="medico-dialog-title">
			<form id="medico-form" method="dialog" class="entity-dialog-form">
				<div class="dialog-heading">
					<h2 id="medico-dialog-title">Médico</h2>
					<button id="cerrar-medico" class="icon-button" type="button" aria-label="Cerrar">
						×
					</button>
				</div>
				<input name="id" type="hidden" />
				<label>
					Nombre completo
					<input name="nombre" required />
				</label>
				<label>
					Especialidad
					<input name="especialidad" required />
				</label>
				<div class="dialog-actions">
					<button id="cancelar-medico-dialog" class="button button-secondary" type="button">
						Cancelar
					</button>
					<button class="button" type="submit">
						Guardar
					</button>
				</div>
			</form>
		</dialog>
		<script>
			import '../scripts/dashboard';
		</script>
	</body>
</html>
